# Copie para .env.local e ajuste para seu ambiente local.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Slug da empresa exibida na home pública (marketing site). Enquanto o site
# não tiver um domínio por empresa, a home mostra sempre esta empresa.
NEXT_PUBLIC_DEFAULT_COMPANY_SLUG=autoprime-demo
