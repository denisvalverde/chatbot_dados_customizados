// AutoPrime - Schema de banco de dados
// Sistema de gestão para lava-rápido / estética automotiva / detail
//
// Multi-tenant: cada linha de negócio (Client, Vehicle, Service, Employee,
// Appointment, ServiceOrder, Transaction, Product, Supplier, Coupon) pertence
// a exatamente uma Company. Um usuário pertence a exatamente uma empresa,
// exceto o papel SUPER_ADMIN (companyId nulo), que gerencia a lista de
// empresas mas não acessa os dados de nenhuma delas.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  WASHER
  DETAILER
  FINANCE
  CLIENT
}

enum FuelType {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  ELECTRIC
  HYBRID
  GAS
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  APPLE_PAY
  GOOGLE_PAY
  BANK_SLIP
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  PIX_MANUAL
  CASH_DESK
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum NotificationChannel {
  EMAIL
  PUSH
  WHATSAPP
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum PhotoStage {
  BEFORE
  DURING
  AFTER
}

// ---------------------------------------------------------------------------
// Multi-tenant
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  vehicles      Vehicle[]
  services      Service[]
  employees     Employee[]
  appointments  Appointment[]
  serviceOrders ServiceOrder[]
  transactions  Transaction[]
  products      Product[]
  suppliers     Supplier[]
  coupons       Coupon[]
  auditLogs     AuditLog[]
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  role              Role
  name              String
  phone             String?
  avatarUrl         String?
  isActive          Boolean   @default(true)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  googleId          String?   @unique
  appleId           String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Nulo apenas para SUPER_ADMIN — todo outro papel pertence a uma empresa.
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employee          Employee?
  client            Client?
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([role])
  @@index([companyId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Employee {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  position        String
  hiredAt         DateTime  @default(now())
  commissionRate  Decimal   @default(0) @db.Decimal(5, 2)
  active          Boolean   @default(true)

  shifts          EmployeeShift[]
  timeEntries     TimeEntry[]
  serviceOrders   ServiceOrder[]      @relation("EmployeeServiceOrders")
  appointmentTeam AppointmentEmployee[]
  commissions     Commission[]

  @@index([active])
  @@index([companyId])
}

model EmployeeShift {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekday     Int      // 0=Sunday .. 6=Saturday
  startTime   String   // "08:00"
  endTime     String   // "18:00"
  breakStart  String?
  breakEnd    String?

  @@index([employeeId])
}

model TimeEntry {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkIn     DateTime
  checkOut    DateTime?
  notes       String?

  @@index([employeeId, checkIn])
}

model Client {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document      String?   // CPF — único apenas dentro da mesma empresa
  rg            String?
  birthDate     DateTime?
  addressStreet String?
  addressNumber String?
  addressCity   String?
  addressState  String?
  addressZip    String?
  lgpdConsentAt DateTime?
  vipSince      DateTime?
  createdAt     DateTime  @default(now())

  vehicles      Vehicle[]
  appointments  Appointment[]
  serviceOrders ServiceOrder[]
  transactions  Transaction[]
  reviews       Review[]
  loyaltyAccount LoyaltyAccount?

  @@unique([companyId, document])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Vehicles
// ---------------------------------------------------------------------------

model Vehicle {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brand       String
  model       String
  year        Int?
  engine      String?
  fuel        FuelType?
  color       String?
  plate       String
  renavam     String?
  km          Int?
  notes       String?
  photos      String[]  @default([])
  createdAt   DateTime  @default(now())

  appointments  Appointment[]
  serviceOrders ServiceOrder[]

  @@index([clientId])
  @@index([companyId])
  @@index([plate])
}

// ---------------------------------------------------------------------------
// Service catalog
// ---------------------------------------------------------------------------

model Service {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  category            String
  description         String?
  price               Decimal  @db.Decimal(10, 2)
  estimatedMinutes    Int
  employeesRequired   Int      @default(1)
  photos              String[] @default([])
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  checklistItems      ServiceChecklistTemplate[]
  productsUsed        ServiceProduct[]
  appointmentServices AppointmentService[]
  serviceOrderItems   ServiceOrderItem[]

  @@index([companyId, category])
  @@index([active])
}

model ServiceChecklistTemplate {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  label     String
  order     Int     @default(0)

  @@index([serviceId])
}

model ServiceProduct {
  id         String   @id @default(uuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Decimal  @db.Decimal(10, 3)

  @@index([serviceId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model Appointment {
  id           String            @id @default(uuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicleId    String
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startAt      DateTime
  endAt        DateTime
  status       AppointmentStatus @default(PENDING)
  notes        String?
  cancelReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  services     AppointmentService[]
  employees    AppointmentEmployee[]
  serviceOrder ServiceOrder?
  review       Review?

  @@index([companyId, startAt, endAt])
  @@index([status])
  @@index([clientId])
}

model AppointmentService {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service     @relation(fields: [serviceId], references: [id])
  priceAtBooking Decimal     @db.Decimal(10, 2)

  @@index([appointmentId])
}

model AppointmentEmployee {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])

  @@unique([appointmentId, employeeId])
}

// ---------------------------------------------------------------------------
// Service orders (Ordem de Serviço)
// ---------------------------------------------------------------------------

model ServiceOrder {
  id             String              @id @default(uuid())
  number         Int                 @unique @default(autoincrement())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointmentId  String?             @unique
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id])
  vehicleId      String
  vehicle        Vehicle             @relation(fields: [vehicleId], references: [id])
  status         ServiceOrderStatus  @default(OPEN)
  startedAt      DateTime?
  finishedAt     DateTime?
  signatureUrl   String?
  qrCode         String?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  employees      Employee[]          @relation("EmployeeServiceOrders")
  items          ServiceOrderItem[]
  checklist      ServiceOrderChecklistItem[]
  photos         ServiceOrderPhoto[]
  transactions   Transaction[]
  payments       Payment[]

  @@index([companyId, status])
  @@index([clientId])
}

model ServiceOrderItem {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  price          Decimal      @db.Decimal(10, 2)

  @@index([serviceOrderId])
}

model ServiceOrderChecklistItem {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  label          String
  checked        Boolean      @default(false)
  checkedAt      DateTime?

  @@index([serviceOrderId])
}

model ServiceOrderPhoto {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  stage          PhotoStage
  url            String
  createdAt      DateTime     @default(now())

  @@index([serviceOrderId, stage])
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Financial
// ---------------------------------------------------------------------------

model Transaction {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           TransactionType
  category       String
  description    String?
  amount         Decimal         @db.Decimal(10, 2)
  method         PaymentMethod?
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceOrderId String?
  serviceOrder   ServiceOrder?   @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([companyId, type, occurredAt])
  @@index([serviceOrderId])
}

model Payment {
  id               String          @id @default(uuid())
  serviceOrderId   String
  serviceOrder     ServiceOrder    @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  provider         PaymentProvider
  method           PaymentMethod
  status           PaymentStatus   @default(PENDING)
  amount           Decimal         @db.Decimal(10, 2)
  providerRef      String?
  pixQrCode        String?
  pixCopyPaste     String?
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([serviceOrderId])
  @@index([status])
}

model Commission {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  referenceMonth String // "2026-07"
  amount       Decimal  @db.Decimal(10, 2)
  paid         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([employeeId, referenceMonth])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Supplier {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  products  Product[]

  @@index([companyId])
}

model Product {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  sku           String?
  barcode       String?
  unit          String   @default("un")
  quantity      Decimal  @default(0) @db.Decimal(10, 3)
  minQuantity   Decimal  @default(0) @db.Decimal(10, 3)
  costPrice     Decimal  @default(0) @db.Decimal(10, 2)
  expiresAt     DateTime?
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  stockMovements StockMovement[]
  usedInServices ServiceProduct[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model StockMovement {
  id         String            @id @default(uuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       StockMovementType
  quantity   Decimal           @db.Decimal(10, 3)
  reason     String?
  createdAt  DateTime          @default(now())

  @@index([productId, createdAt])
}

// ---------------------------------------------------------------------------
// Loyalty / marketing (schema only — lógica em fase 2, ver README)
// ---------------------------------------------------------------------------

model LoyaltyAccount {
  id        String   @id @default(uuid())
  clientId  String   @unique
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  cashback  Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}

model Coupon {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountAmount  Decimal?  @db.Decimal(10, 2)
  validFrom       DateTime
  validUntil      DateTime
  maxUses         Int?
  usedCount       Int       @default(0)
  active          Boolean   @default(true)

  @@unique([companyId, code])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    NotificationChannel
  title      String
  body       String
  status     NotificationStatus  @default(QUEUED)
  metadata   Json?
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId, status])
}
