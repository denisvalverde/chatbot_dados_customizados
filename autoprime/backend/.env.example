# Copie para .env e ajuste os valores para seu ambiente local.
# Nunca commite o arquivo .env (já está no .gitignore).

NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

DATABASE_URL=postgresql://autoprime:autoprime@localhost:5432/autoprime?schema=public
REDIS_URL=redis://localhost:6379

# Gere valores aleatórios fortes, por exemplo: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-forte
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-forte
JWT_REFRESH_EXPIRES_IN=7d

# Opcionais — sem elas, os recursos correspondentes rodam em modo mock/sandbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AutoPrime <no-reply@autoprime.app>

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=
PIX_KEY=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

FIREBASE_SERVER_KEY=

ANTHROPIC_API_KEY=
