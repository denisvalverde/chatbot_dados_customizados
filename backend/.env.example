# Copie para .env e ajuste. Nenhum valor real de segredo deve ser commitado.

# --- Aplicacao ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Banco de dados ---
# Local (padrao, zero configuracao): SQLite em ./data/platform.db
# DATABASE_URL=sqlite:///./data/platform.db
# Producao (Docker Compose usa Postgres automaticamente):
POSTGRES_USER=sreai
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sreai
POSTGRES_PORT=5432

# --- Redis (opcional; fila/cache) ---
REDIS_PORT=6379

# --- Seguranca ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-esta-chave-para-32-bytes-aleatorios-ou-mais
JWT_EXPIRATION_MINUTES=480
ADMIN_EMAIL=admin@example.com
# Se vazio, o seed gera uma senha aleatoria e imprime uma unica vez no console.
ADMIN_PASSWORD=

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Embeddings: local (padrao, offline) | sentence-transformers | openai ---
EMBEDDING_PROVIDER=local
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Vector store: local (padrao) | pgvector (requer Postgres + migrations/pgvector.sql) ---
VECTOR_BACKEND=local

# --- LLM: local (padrao, sem custo/API) | openai | anthropic ---
# Sem chave configurada, a plataforma funciona 100% com regras + templates locais.
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- API / porta exposta pelo Docker Compose ---
API_PORT=8000

# --- MLOps (opcional) ---
# pip install mlflow  para habilitar o rastreamento de experimentos.
